// Brightloop — Subscription Management System
// Data model. After changing it, run `npm run db:update` (run.bat does this on every start).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
enum Role {
  ADMIN
  INTERNAL
  CUSTOMER
}

enum ProductType {
  SERVICE
  SOFTWARE
  ADDON
  PHYSICAL
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AmountType {
  PERCENT
  FIXED
}

enum DiscountScope {
  PRODUCT       // applies to lines whose product is in `products`
  SUBSCRIPTION  // applies to whole subscription when attached (subscription.discountId)
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

// ───────────── Identity ─────────────
model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role      @default(CUSTOMER)
  isActive         Boolean   @default(true)
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer          Customer?
  subscriptionsSold Subscription[]      @relation("Salesperson")
  paymentsRecorded  Payment[]
  events            SubscriptionEvent[]
}

// A billing contact. Created on customer signup OR by staff (portal login optional).
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  address   String?
  city      String?
  country   String?
  gstin     String?
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([name])
}

// ───────────── Catalog ─────────────
model Tax {
  id        Int        @id @default(autoincrement())
  name      String     // e.g. "GST 18%"
  type      AmountType @default(PERCENT)
  rate      Decimal    @db.Decimal(10, 2) // 18 => 18% ; FIXED => amount per unit
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  products          Product[]
  subscriptionLines SubscriptionLine[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  type        ProductType @default(SOFTWARE)
  salesPrice  Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  tagline     String?     // one line shown to customers in the catalog
  features    String[]    @default([]) // what the customer gets, shown as a short list
  artKey      String?     // built-in illustration (care, creative, cloud, meet, vault, music, crm, erp, connector, support)
  imageUrl    String?     // optional real photo; overrides the illustration
  inCatalog   Boolean     @default(false) // customers can request it from the portal
  taxId       Int?        // default tax rule applied to lines of this product
  tax         Tax?        @relation(fields: [taxId], references: [id])
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants          ProductVariant[]
  discounts         Discount[]         @relation("DiscountProducts")
  subscriptionLines SubscriptionLine[]
  templateLines     TemplateLine[]
  invoiceLines      InvoiceLine[]

  @@index([name])
}

// e.g. attribute "Brand", value "Odoo", extraPrice 560
model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  subscriptionLines SubscriptionLine[]
  templateLines     TemplateLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String
  price         Decimal       @default(0) @db.Decimal(12, 2) // base fee per billing period (added as an invoice line when > 0)
  billingPeriod BillingPeriod @default(MONTHLY)
  intervalCount Int           @default(1) // bill every N periods
  minQuantity   Int           @default(1)
  startDate     DateTime?     // plan available from
  endDate       DateTime?     // plan available until
  autoClose     Boolean       @default(false) // close subscriptions automatically at expiry
  closable      Boolean       @default(true)  // can be closed early
  pausable      Boolean       @default(false)
  renewable     Boolean       @default(true)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  code        String?       @unique
  type        AmountType    @default(PERCENT)
  value       Decimal       @db.Decimal(12, 2)
  scope       DiscountScope @default(SUBSCRIPTION)
  minPurchase Decimal?      @db.Decimal(12, 2) // min subtotal (SUBSCRIPTION) or line subtotal (PRODUCT)
  minQuantity Int?
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?          // null = unlimited; one use = one invoice it was applied to
  usedCount   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products      Product[]      @relation("DiscountProducts")
  subscriptions Subscription[]
  invoiceLines  InvoiceLine[]
}

model QuotationTemplate {
  id           Int            @id @default(autoincrement())
  name         String
  validityDays Int            @default(30)
  planId       Int
  plan         Plan           @relation(fields: [planId], references: [id])
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  lines        TemplateLine[]
  subscriptions Subscription[]
}

model TemplateLine {
  id         Int               @id @default(autoincrement())
  templateId Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product           @relation(fields: [productId], references: [id])
  variantId  Int?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  quantity   Int               @default(1)
}

// ───────────── Sales ─────────────
model Subscription {
  id                 Int                @id @default(autoincrement())
  number             String             @unique // SUB/2026/00001
  customerId         Int
  customer           Customer           @relation(fields: [customerId], references: [id])
  planId             Int
  plan               Plan               @relation(fields: [planId], references: [id])
  templateId         Int?
  template           QuotationTemplate? @relation(fields: [templateId], references: [id])
  salespersonId      Int?
  salesperson        User?              @relation("Salesperson", fields: [salespersonId], references: [id])
  discountId         Int?               // SUBSCRIPTION-scope discount attached by staff
  discount           Discount?          @relation(fields: [discountId], references: [id])
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  expiryDate         DateTime?
  nextInvoiceDate    DateTime?          // set on activation, advanced by billing engine
  paymentTermDays    Int                @default(15) // invoice dueDate = invoiceDate + N
  quotationValidUntil DateTime?
  notes              String?
  requestedByCustomer Boolean           @default(false) // created from the portal catalog; staff turn it into an offer
  closedAt           DateTime?
  closeReason        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines    SubscriptionLine[]
  invoices Invoice[]
  events   SubscriptionEvent[]

  @@index([status])
  @@index([customerId])
  @@index([status, nextInvoiceDate])
}

model SubscriptionLine {
  id             Int             @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  variantId      Int?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2) // product price + variant extra (snapshot)
  taxId          Int?
  tax            Tax?            @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
}

// Status timeline — "anyone on the team can see where it stands"
model SubscriptionEvent {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  note           String?
  userId         Int?
  user           User?               @relation(fields: [userId], references: [id])
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
}

// ───────────── Billing ─────────────
model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique // INV/2026/00001
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  // THE double-billing guard: one invoice per subscription per period.
  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([invoiceDate])
}

model InvoiceLine {
  id             Int       @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      Int?
  product        Product?  @relation(fields: [productId], references: [id])
  description    String
  quantity       Int       @default(1)
  unitPrice      Decimal   @db.Decimal(12, 2)
  discountId     Int?
  discount       Discount? @relation(fields: [discountId], references: [id])
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  taxName        String?
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2)
  subtotal       Decimal   @db.Decimal(12, 2) // qty*unit - discount
  total          Decimal   @db.Decimal(12, 2) // subtotal + tax

  @@index([invoiceId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  number       String        @unique // PAY/2026/00001
  invoiceId    Int
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime      @default(now())
  note         String?
  recordedById Int?
  recordedBy   User?         @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
}

// Atomic document numbering (SUB / INV / PAY) — see src/lib/sequence.js
model Sequence {
  key  String @id // e.g. "INV-2026"
  next Int    @default(1)
}
