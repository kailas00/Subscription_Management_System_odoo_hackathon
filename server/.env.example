# Copy to .env  (never commit .env)
PORT=4000
NODE_ENV=development
# run.bat sets this automatically: your PostgreSQL on port 5432 if it is running, otherwise a built-in database on 5433
DATABASE_URL="postgresql://postgres:brightloop@localhost:5433/brightloop?schema=public"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
CURRENCY=INR

# Email (password reset, invoice send). Leave SMTP_HOST empty => emails are printed to the console.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop <no-reply@brightloop.dev>"

# Billing engine cron (daily 02:00). Set to "false" to disable.
BILLING_CRON="0 2 * * *"
